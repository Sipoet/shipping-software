<h1><%=Port.model_name.human%></h1>
<div class="text-end">
  <a href="<%=new_port_path%>" class="btn btn-primary">Tambah</a>
</div>
<div data-controller="port">
  <table class="table table-striped table-hover table-sm" id="port-table">
    <thead>
      <tr>
        <th><%=Port.human_attribute_name(:name)%></th>
        <th><%=Port.human_attribute_name(:city)%></th>
        <th><%=Port.human_attribute_name(:country)%></th>
        <th><%=ApplicationRecord.human_attribute_name(:created_at)%></th>
        <th><%=ApplicationRecord.human_attribute_name(:updated_at)%></th>
        <th>Action</th>
      </tr>
      <tr>
        <td><input type="text" data-action="focusout -> port#columnFilter" data-column-index="0" placeholder="Cari <%=Port.human_attribute_name(:name)%>" /></td>
        <td><input type="text" data-action="focusout -> port#columnFilter" data-column-index="1" placeholder="Cari <%=Port.human_attribute_name(:city)%>" /></td>
        <td><input type="text" data-action="focusout -> port#columnFilter" data-column-index="2" placeholder="Cari <%=Port.human_attribute_name(:country)%>" /></td>
        <td><input type="date" data-action="focusout -> port#columnFilter" data-column-index="3" placeholder="Cari <%=ApplicationRecord.human_attribute_name(:created_at)%>" /></td>
        <td><input type="date" data-action="focusout -> port#columnFilter" data-column-index="4" placeholder="Cari <%=ApplicationRecord.human_attribute_name(:updated_at)%>" /></td>
        <td></td>
      </tr>
    </thead>
  </table>
</div>