<h1><%=Port.model_name.human%></h1>
<div class="text-end">
  <a href="<%=new_port_path%>" class="btn btn-primary">Tambah</a>
</div>
<br/>
<div data-controller="table" data-path="<%=ports_path(format: :json)%>">
  <table class="table table-striped table-hover table-sm">
    <thead>
      <tr>
        <th data-field="name"><%=Port.human_attribute_name(:name)%></th>
        <th data-field="city"><%=Port.human_attribute_name(:city)%></th>
        <th data-field="country"><%=Port.human_attribute_name(:country)%></th>
        <th data-field="created_at" data-field-type="datetime"><%=ApplicationRecord.human_attribute_name(:created_at)%></th>
        <th data-field="updated_at" data-field-type="datetime"><%=ApplicationRecord.human_attribute_name(:updated_at)%></th>
        <th data-field-type="action" data-no-sort data-row-button="edit,view">Action</th>
      </tr>
    </thead>
  </table>
</div>