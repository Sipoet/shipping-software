<div class="card">
  <h5 class="card-header">Detail <%=Port.model_name.human%></h5>
  <div class="card-body">
    <div class="mb-3 row">
      <label for="staticName" class="col-sm-2 fw-bold col-form-label"><%=Port.human_attribute_name(:name)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" id="staticName" value="<%=@port.name%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticCity" class="col-sm-2 fw-bold col-form-label"><%=Port.human_attribute_name(:city)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" id="staticCity" value="<%=@port.city%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticCountry" class="col-sm-2 fw-bold col-form-label"><%=Port.human_attribute_name(:country)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" id="staticCountry" value="<%=@port.country%>">
      </div>
    </div>
  </div>
  <div class="card-footer">
    <a href="<%=edit_port_path(id: @port.id)%>" class="btn btn-primary" >Edit</a>
  </div>
</div>