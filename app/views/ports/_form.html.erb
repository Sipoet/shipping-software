
<%=show_alert_if_exists%>

<%= form_with model: port do |form| %>
  <div class="mb-3">
    <%= form.label :name, class:'form-label' %>
    <%= form.text_field :name, class: 'form-control', aria_describedby:'port.name' %>
    <div id="port.name" class="form-text">Nama Pelabuhan.</div>
  </div>
  <div class="mb-3">
    <%= form.label :city, class:'form-label' %>
    <%= form.text_field :city, class: 'form-control', aria_describedby:'port.city' %>
    <div id="port.city" class="form-text">Kota.</div>
  </div>
  <div class="mb-3">
    <%= form.label :country, class:'form-label' %>
    <%= form.text_field :country, class: 'form-control', aria_describedby:'port.country' %>
    <div id="port.country" class="form-text">Negara.</div>
  </div>
  <%= form.submit "Simpan", class: 'btn btn-primary'%>
  <!--<button type="submit" class="btn btn-primary">Submit</button>-->
<%end%>