
<div class="card mb-4">
<%=show_alert_if_exists%>

<%= form_with model: product do |form| %>
  <div class="card-body">
    <div class="mb-3">
      <label class="form-label" for="product_name"><%=Customer.human_attribute_name(:name)%></label>
      <input class="form-control" aria-describedby="product.name" type="text" value="<%=product.name%>" name="product[name]" id="product_name" />
      <div id="product.name" class="form-text">Nama Produk.</div>
    </div>
    <div class="mb-3">
      <%= form.label :product_type, class:'form-label' %>
      <select name="product[product_type]" class="form-select" id="product_product_type" data-controller= 'select2' data-select-label="name" data-path="<%=ports_path(format: :json)%>" aria-describedby='product.product_type'>
        <%if product.product_type.present?%>
          <option selected value="<%=product.product_type_id%>">
            <%="#{product.product_type.name} (#{product.product_type.city})"%>
          </option>
        <%end%>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_address"><%=Customer.human_attribute_name(:address)%></label>
      <textarea id="product_address" class="form-control" name="product[address]" rows="5" value="<%=product.address%>" placeholder="Alamat" aria-describedby='product.address'></textarea>
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_contact_number"><%=Customer.human_attribute_name(:contact_number)%></label>
      <%=render partial: 'shared/phone_input',locals:{value: product.contact_number, model_name: :product, column_key: :contact_number}%>
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_bank"><%=Customer.human_attribute_name(:bank)%></label>
      <input class="form-control" aria-describedby="product.bank" type="text" value="<%=product.bank%>" name="product[bank]" id="product_bank" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_bank_account"><%=Customer.human_attribute_name(:bank_account)%></label>
      <input class="form-control" aria-describedby="product.bank_account" type="text" value="<%=product.bank_account%>" name="product[bank_account]" id="product_bank_account" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_bank_register_name"><%=Customer.human_attribute_name(:bank_register_name)%></label>
      <input class="form-control" aria-describedby="product.bank_register_name" type="text" value="<%=product.bank_register_name%>" name="product[bank_register_name]" id="product_bank_register_name" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="product_tax_account"><%=Customer.human_attribute_name(:tax_account)%></label>
      <input class="form-control" aria-describedby="product.tax_account" type="text" value="<%=product.tax_account%>" name="product[tax_account]" id="product_tax_account" />
    </div>
  </div>
  <div class="card-footer">
    <%= form.submit "Simpan", class: 'btn btn-primary'%>
  </div>
<%end%>
</div>