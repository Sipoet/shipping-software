<h1><%=Product.model_name.human%></h1>
<div class="text-end">
  <a href="<%=new_product_path%>" class="btn btn-primary">Tambah</a>
</div>
<br/>
<div data-controller="table" data-path="<%=products_path(format: :json)%>">
  <table class="table table-striped table-hover table-sm">
    <thead>
      <tr>

        <th data-field="name"><%=Product.human_attribute_name(:name)%></th>
        <th data-field="product_type" data-field-type="enum" data-enum="<%=enum_list(Product,:product_type).to_json%>" ><%=Product.human_attribute_name(:product_type)%></th>
        <th data-field="weight" data-field-type="number"><%=Product.human_attribute_name(:weight)%></th>
        <th data-field="dimension_p" data-field-type="number"><%=Product.human_attribute_name(:dimension_p)%></th>
        <th data-field="dimension_l" data-field-type="number"><%=Product.human_attribute_name(:dimension_l)%></th>
        <th data-field="dimension_t"><%=Product.human_attribute_name(:dimension_t)%></th>
        <th data-field="created_at" data-field-type="datetime"><%=ApplicationRecord.human_attribute_name(:created_at)%></th>
        <th data-field="updated_at" data-field-type="datetime"><%=ApplicationRecord.human_attribute_name(:updated_at)%></th>
        <th data-field-type="action" data-no-sort data-row-button="edit,view">Action</th>
      </tr>
    </thead>
  </table>
</div>