
<%=show_alert_if_exists%>

<%= form_with model: ship_schedule do |form| %>
  <div class="mb-3">
    <%= form.label :status, class:'col-form-label col-sm-2' %>
    <div class="col-sm-10">
      <h5><span class="badge text-bg-<%=ship_schedule_status_css(ship_schedule)%>"><%=ship_schedule.status%></span></h5>
    </div>
  </div>
  <div class="mb-3">
    <%= form.label :ship, class:'form-label' %>
    <select name="ship_schedule[ship_id]" class="form-select" id="ship_schedule_ship" data-controller= 'select2' data-select-label="name" data-path="<%=ships_path(format: :json)%>" aria-describedby='ship_schedule.ship'>
      <%if ship_schedule.ship.present?%><option selected value="<%=ship_schedule.ship_id%>"><%=ship_schedule.ship.name%></option><%end%>
    </select>
  </div>
  <div class="mb-3">
    <%= form.label :voyage, class:'form-label' %>
    <%= form.text_field :voyage, class: 'form-control', aria_describedby:'ship_schedule.voyage' %>
  </div>
  <div class="mb-3">
    <%= form.label :loading_port, class:'form-label' %>
    <select name="ship_schedule[loading_port_id]" class="form-select" id="ship_schedule_loading_port" data-controller= 'select2' data-select-label="name" data-path="<%=ports_path(format: :json)%>" aria-describedby='ship_schedule.loading_port'>
      <%if ship_schedule.loading_port.present?%><option selected value="<%=ship_schedule.loading_port_id%>"><%=port_format(ship_schedule.loading_port)%></option><%end%>
    </select>
  </div>
  <div class="mb-3">
    <%= form.label :destination_port, class:'form-label' %>
    <select name="ship_schedule[destination_port_id]" class="form-select" id="ship_schedule_destination_port" data-controller= 'select2' data-select-label="name" data-path="<%=ports_path(format: :json)%>" aria-describedby='ship_schedule.destination_port'>
      <%if ship_schedule.destination_port.present?%><option selected value="<%=ship_schedule.destination_port_id%>"><%=port_format(ship_schedule.destination_port)%></option><%end%>
    </select>
  </div>
  <div class="mb-3">
    <%= form.label :estimated_arrived_sour_at, class:'form-label' %>
    <%= form.datetime_field :estimated_arrived_sour_at, class: 'form-control', aria_describedby:'ship_schedule.estimated_arrived_sour_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :estimated_departure_sour_at, class:'form-label' %>
    <%= form.datetime_field :estimated_departure_sour_at, class: 'form-control', aria_describedby:'ship_schedule.estimated_departure_sour_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :estimated_arrived_dest_at, class:'form-label' %>
    <%= form.datetime_field :estimated_arrived_dest_at, class: 'form-control', aria_describedby:'ship_schedule.estimated_arrived_dest_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :actual_arrived_sour_at, class:'form-label' %>
    <%= form.datetime_field :actual_arrived_sour_at, class: 'form-control', aria_describedby:'ship_schedule.actual_arrived_sour_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :actual_departure_sour_at, class:'form-label' %>
    <%= form.datetime_field :actual_departure_sour_at, class: 'form-control', aria_describedby:'ship_schedule.actual_departure_sour_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :actual_arrived_dest_at, class:'form-label' %>
    <%= form.datetime_field :actual_arrived_dest_at, class: 'form-control', aria_describedby:'ship_schedule.actual_arrived_dest_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :dorry_container_opened_at, class:'form-label' %>
    <%= form.datetime_field :dorry_container_opened_at, class: 'form-control', aria_describedby:'ship_schedule.dorry_container_opened_at' %>
  </div>
  <div class="mb-3">
    <%= form.label :booking_code, class:'form-label' %>
    <%= form.text_field :booking_code, class: 'form-control', aria_describedby:'ship_schedule.booking_code' %>
  </div>
  <%= form.submit "Simpan", class: 'btn btn-primary'%>
  <!--<button type="submit" class="btn btn-primary">Submit</button>-->
<%end%>