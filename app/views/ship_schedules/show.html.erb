<div class="accordion" id="ship-schedule">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button" type="button" data-coreui-toggle="collapse" data-coreui-target="#ship-schedule-detail" aria-expanded="true" aria-controls="ship-schedule-detail">
       <strong> Detail <%=ShipSchedule.model_name.human%></strong>
      </button>
    </h2>
    <div id="ship-schedule-detail" class="accordion-collapse collapse show" data-coreui-parent="#ship-schedule">
      <div class="accordion-body">
        <div class="btn-action-container">
          <a href="<%=edit_ship_schedule_path(id: @ship_schedule.id)%>" class="btn btn-primary" >Edit</a>
          <%=status_buttons(@ship_schedule) %>
        </div>
        <div class="mb-3 row">
          <label for="ship" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:ship)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="ship" value="<%=@ship_schedule.ship.name%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="status" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:status)%></label>
          <div class="col-sm-9">
            <h5><span class="badge text-bg-<%=ship_schedule_status_css(@ship_schedule)%>"><%=@ship_schedule.status%></span></h5>

          </div>
        </div>
        <div class="mb-3 row">
          <label for="loading_port" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:loading_port)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="loading_port" value="<%=port_format(@ship_schedule.loading_port)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="destination_port" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:destination_port)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="destination_port" value="<%=port_format(@ship_schedule.destination_port)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="estimated_arrived_sour_at" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:actual_arrived_sour_at)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="actual_arrived_sour_at" value="<%= comparison_datetime(@ship_schedule.estimated_arrived_sour_at, @ship_schedule.actual_arrived_sour_at)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="actual_departure_sour_at" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:actual_departure_sour_at)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="actual_departure_sour_at" value="<%= comparison_datetime(@ship_schedule.estimated_departure_sour_at, @ship_schedule.actual_departure_sour_at)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="actual_arrived_dest_at" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:actual_arrived_dest_at)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="actual_arrived_dest_at" value="<%= comparison_datetime(@ship_schedule.estimated_arrived_dest_at, @ship_schedule.actual_arrived_dest_at)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="dorry_container_opened_at" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:dorry_container_opened_at)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="dorry_container_opened_at" value="<%= datetime_format(@ship_schedule.dorry_container_opened_at)%>">
          </div>
        </div>
        <div class="mb-3 row">
          <label for="booking_code" class="col-sm-3 fw-bold col-form-label"><%=ShipSchedule.human_attribute_name(:booking_code)%></label>
          <div class="col-sm-9">
            <input type="text" readonly class="form-control-plaintext" id="booking_code" value="<%= @ship_schedule.booking_code%>">
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-coreui-toggle="collapse" data-coreui-target="#container" aria-expanded="true" aria-controls="container">
       <strong><%=Container.model_name.human%></strong>
      </button>
    </h2>
    <div id="container" class="accordion-collapse collapse" data-coreui-parent="#ship-schedule">
      <div class="accordion-body">
        <div class="text-right"><a href="<%=new_container_path(ship_schedule_id: @ship_schedule.id)%>" class="btn btn-primary">Tambah</a></div>
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th><%=Container.human_attribute_name(:container_type)%></th>
                <th><%=Container.human_attribute_name(:container_number)%></th>
                <th><%=Container.human_attribute_name(:seal_number)%></th>
                <th><%=Container.human_attribute_name(:order_type)%></th>
                <th><%=Container.human_attribute_name(:agent)%></th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <%@ship_schedule.containers.includes(:container_type).each do |container|%>
                <tr>
                  <td><%=container.container_type.name %></td>
                  <td><%=container.container_number %></td>
                  <td><%=container.seal_number %></td>
                  <td><%=container.order_type %></td>
                  <td><%=container.agent.name %></td>
                  <td><a href="<%=edit_container_path(id: container.id)%>" class="btn btn-primary">Edit</a></td>
                </tr>
              <%end%>
              <%if @ship_schedule.containers.blank?%>
                <tr><td colspan="6" class="text-center">Tidak ada Kontainer</td></tr>
                <%end%>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<br />
