<h1><%=Ship.model_name.human%></h1>
<div class="text-end">
  <a href="<%=new_ship_path%>" class="btn btn-primary">Tambah</a>
</div>
<div data-controller="ship">
  <table class="table table-striped table-hover table-sm" id="ship-table">
    <thead>
      <tr>
        <th><%=Ship.human_attribute_name(:name)%></th>
        <th><%=ApplicationRecord.human_attribute_name(:created_at)%></th>
        <th><%=ApplicationRecord.human_attribute_name(:updated_at)%></th>
        <th>Action</th>
      </tr>
      <tr>
        <td><input type="text" data-action="focusout -> ship#columnFilter" data-column-index="0" placeholder="Cari <%=Ship.human_attribute_name(:name)%>" /></td>
        <td><input type="date" data-action="focusout -> ship#columnFilter" data-column-index="1" placeholder="Cari <%=ApplicationRecord.human_attribute_name(:created_at)%>" /></td>
        <td><input type="date" data-action="focusout -> ship#columnFilter" data-column-index="2" placeholder="Cari <%=ApplicationRecord.human_attribute_name(:updated_at)%>" /></td>
        <td></td>
      </tr>
    </thead>
  </table>
</div>