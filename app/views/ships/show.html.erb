<div class="card">
  <h5 class="card-header">Detail <%=Ship.model_name.human%></h5>
  <div class="card-body">
    <div class="mb-3 row">
      <label for="staticName" class="col-sm-2 fw-bold col-form-label"><%=Ship.human_attribute_name(:name)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" id="staticName" value="<%=@ship.name%>">
      </div>
    </div>
  </div>
  <div class="card-footer ">
    <a href="<%=edit_ship_path(id: @ship.id)%>" class="btn btn-primary" >Edit</a>
  </div>
</div>