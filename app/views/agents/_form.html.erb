
<div class="card mb-4">
<%=show_alert_if_exists%>

<%= form_with model: agent do |form| %>
  <div class="card-body">
    <div class="mb-3">
      <label class="form-label" for="agent_name"><%=Agent.human_attribute_name(:name)%></label>
      <input class="form-control" aria-describedby="agent.name" type="text" value="<%=agent.name%>" name="agent[name]" id="agent_name" />
      <div id="agent.name" class="form-text">Nama Agent.</div>
    </div>
    <div class="mb-3">
      <%= form.label :default_port, class:'form-label' %>
      <select name="agent[default_port_id]" class="form-select" id="agent_default_port" data-controller= 'select2' data-select-label="name" data-path="<%=ports_path(format: :json)%>" aria-describedby='agent.default_port'>
        <%if agent.default_port.present?%>
          <option selected value="<%=agent.default_port_id%>">
            <%="#{agent.default_port.name} (#{agent.default_port.city})"%>
          </option>
        <%end%>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_address"><%=Agent.human_attribute_name(:address)%></label>
      <textarea id="agent_address" class="form-control" name="agent[address]" rows="5" value="<%=agent.address%>" placeholder="Alamat" aria-describedby='agent.address'></textarea>
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_contact_number"><%=Agent.human_attribute_name(:contact_number)%></label>
      <%=render partial: 'shared/phone_input',locals:{value: agent.contact_number, model_name: :agent, column_key: :contact_number}%>
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_bank"><%=Agent.human_attribute_name(:bank)%></label>
      <input class="form-control" aria-describedby="agent.bank" type="text" value="<%=agent.bank%>" name="agent[bank]" id="agent_bank" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_bank_account"><%=Agent.human_attribute_name(:bank_account)%></label>
      <input class="form-control" aria-describedby="agent.bank_account" type="text" value="<%=agent.bank_account%>" name="agent[bank_account]" id="agent_bank_account" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_bank_register_name"><%=Agent.human_attribute_name(:bank_register_name)%></label>
      <input class="form-control" aria-describedby="agent.bank_register_name" type="text" value="<%=agent.bank_register_name%>" name="agent[bank_register_name]" id="agent_bank_register_name" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="agent_tax_account"><%=Agent.human_attribute_name(:tax_account)%></label>
      <input class="form-control" aria-describedby="agent.tax_account" type="text" value="<%=agent.tax_account%>" name="agent[tax_account]" id="agent_tax_account" />
    </div>
  </div>
  <div class="card-footer">
    <%= form.submit "Simpan", class: 'btn btn-primary'%>
  </div>
<%end%>
</div>