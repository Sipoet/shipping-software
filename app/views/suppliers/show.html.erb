<div class="card">
  <h5 class="card-header">Detail <%=Supplier.model_name.human%></h5>
  <div class="card-body">
    <div class="mb-3 row">
      <label for="staticName" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:name)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" value="<%=@supplier.name%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticDefaultPort" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:default_port)%></label>
      <div class="col-sm-10">
        <%if @supplier.default_port.present?%>
          <a href="<%=port_path(id: @supplier.default_port_id)%>" class="btn btn-link"><%=@supplier.default_port.name%> (<%=@supplier.default_port.city%>)</a>
        <%end%>
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticAddress" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:address)%></label>
      <div class="col-sm-10">
        <p><%=@supplier.address%></p>
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticBank" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:bank)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" value="<%=@supplier.bank%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticBankAccount" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:bank_account)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" value="<%=@supplier.bank_account%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticBankAccount" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:bank_register_name)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext" value="<%=@supplier.bank_register_name%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticTaxAccount" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:tax_account)%></label>
      <div class="col-sm-10">
        <input type="text" readonly class="form-control-plaintext"  value="<%=@supplier.tax_account%>">
      </div>
    </div>
    <div class="mb-3 row">
      <label for="staticContactNumber" class="col-sm-2 fw-bold col-form-label"><%=Supplier.human_attribute_name(:contact_number)%></label>
      <div class="col-sm-10">
        <div class="input-group">
          <input type="text" readonly class="form-control" value="<%=@supplier.contact_number%>">
          <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-coreui-toggle="dropdown" aria-expanded="false">Dropdown</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="tel:<%=@supplier.contact_number%>"><i class="ph ph-phone" class="btn btn-info"></i>call</a></li>
            <li><a class="dropdown-item" href="https://api.whatsapp.com/send?phone=<%=@supplier.contact_number%>"><i class="ph ph-whatsapp-logo"></i>whatsapp</a></li>
          </ul>
        </div>


      </div>
    </div>
  </div>
  <div class="card-footer">
    <a href="<%=edit_supplier_path(id: @supplier.id)%>" class="btn btn-primary" >Edit</a>
  </div>
</div>