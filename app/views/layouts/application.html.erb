<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shipping Software" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%=vite_asset_path('assets/images/logo.jpg')%>" type="image/jpg">
    <link rel="apple-touch-icon" href="<%=vite_asset_path('assets/images/logo.jpg')%>">
    <%#= vite_stylesheet_tag  "stylesheets/application.scss" %>
  </head>

  <body>
    <noscript>
      You need to enable JavaScript to run this app
    </noscript>
    <div id="root"></div>
    <%= vite_javascript_tag  "application.jsx", type: "module" %>
  </body>
</html>

