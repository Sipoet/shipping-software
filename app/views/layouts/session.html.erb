<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shipping Software" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%=image_path('logo.jpg')%>" type="image/jpg">
    <link rel="apple-touch-icon" href="<%=image_path('logo.jpg')%>">

    <%= stylesheet_link_tag "application" %>

  </head>

  <body>
    <div class="bg-body-tertiary min-vh-100 d-flex flex-row align-items-center">
      <div class="container">
        <%= yield %>
      </div>
    </div>
    <footer class="footer px-4">
      <div> © <%=Date.today.year%> Cipta Karya Agung Sejahtera.</div>
    </footer>
    <%= javascript_include_tag "application", type: "module" %>
  </body>
</html>

