<div class="row justify-content-center">
  <div class="col-lg-8">
    <%=show_alert_if_exists%>
    <div class="card-group d-block d-md-flex row">
      <div class="card col-md-7 p-4 mb-0">
        <div class="card-body">
          <h1>Login</h1>
          <p class="text-body-secondary">Sign In to your account</p>
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="input-group mb-3">
              <span class="input-group-text">
                <i class="icon icon-lg ph ph-user"></i>
              </span>
              <%= f.text_field :username, autofocus: true, autocomplete: "username",placeholder: 'Username', class: 'form-control'%>
            </div>
            <div class="input-group mb-4"><span class="input-group-text">
              <i class="icon icon-lg ph ph-lock"></i></span>
              <%= f.password_field :password, autocomplete: "current-password", class: 'form-control', placeholder:"Password" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-4 form-check">
                <%= f.check_box :remember_me ,class: "form-check-input"%>
                <%= f.label :remember_me, class: 'form-check-label' %>
              </div>
            <% end %>
            <div class="row">
              <div class="col-6">
                <%= f.submit "Log in", class:'btn btn-primary px-4' do%>
                  Login
                <%end%>
              </div>
              <div class="col-6 text-end">
                <button class="btn btn-link px-0" type="button">Forgot password?</button>
              </div>
            </div>
          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>

