{
  "name": "app",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.25.3",
    "esbuild-sass-plugin": "^3.3.1",
    "vite": "^5.4.19",
    "vite-plugin-ruby": "^5.1.1"
  },
  "scripts": {
    "build:js": "node app/javascript/esbuild.config.mjs",
    "watch:js": "nodemon --watch ./app/javascript/ --ext scss,js,jsx,css --exec \"npm run build:js\"",
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "npm run build:css:compile && npm run build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"npm run build:css\""
  },
  "dependencies": {
    "@coreui/coreui-free-react-admin-template": "github:coreui/coreui-free-react-admin-template",
    "@coreui/react": "^5.5.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.10",
    "@phosphor-icons/react": "^2.1.7",
    "@phosphor-icons/web": "^2.1.2",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "bootstrap": "^5.3.3",
    "luxon": "^3.6.1",
    "nodemon": "^3.1.7",
    "pluralize": "^8.0.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.3",
    "react-select": "^5.10.1",
    "react-tabulator": "^0.21.0",
    "sass": "^1.79.4",
    "simplebar": "^6.2.7",
    "tabulator-tables": "^6.3.1",
    "tom-select": "^2.4.3",
    "yaml": "^2.5.1"
  },
  "browserslist": [
    "defaults"
  ]
}
